# Streamlit secrets template — DO NOT put real secrets in this file.
#
# This file is committed as documentation. The real secrets file,
# .streamlit/secrets.toml, is already gitignored (see .gitignore) and must
# never be committed.
#
# Local setup:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   then edit .streamlit/secrets.toml and set a real ADMIN_TOKEN value.
#
# Streamlit Community Cloud setup:
#   App → Settings → Secrets → paste the contents below with a real token,
#   then save. Community Cloud injects it as st.secrets at runtime — no file
#   needs to exist in the repo or the deployed container.
#
# ADMIN_TOKEN gates the toolbar-visible admin view in demo/app.py:
#   https://<your-app>.streamlit.app/?admin=<ADMIN_TOKEN>   → full chrome (you)
#   https://<your-app>.streamlit.app/                        → auto-redirects
#                                                                everyone else
#                                                                into ?embed=true
#
# Pick a long, random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).

ADMIN_TOKEN = "replace-with-a-long-random-string"
